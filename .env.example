# Alpaca API Configuration
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Mode
TRADING_MODE=paper

# Market Data API
MARKET_DATA_API=polygon
POLYGON_API_KEY=your_polygon_api_key_here

# News API
NEWS_API_KEY=your_newsapi_key_here
FINANCIAL_NEWS_API=financialmodelingprep

# System Configuration
LOGGING_DIR=./logs
TRADE_LOG_FILE=./logs/trades.json
SIGNAL_LOG_FILE=./logs/signals.json
PERFORMANCE_LOG_FILE=./logs/performance.json

# Account Configuration
RISK_PER_TRADE=0.005
DAILY_MAX_LOSS=0.02
MIN_ACCOUNT_SIZE=10000

# Trading Parameters
MIN_VOLUME=1000000
MIN_DOLLAR_VOLUME=50000000
MIN_RVOL=1.5
MIN_SCORE=70
WATCH_SCORE_MIN=60
WATCH_SCORE_MAX=69

# Time Configuration
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
EXIT_BEFORE_CLOSE=15:45
TIMEZONE=America/New_York
